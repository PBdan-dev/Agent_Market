DATABASE_URL="file:./dev.db"
# Secret de signature des sessions : 32 caractères aléatoires minimum (openssl rand -base64 32)
SESSION_SECRET="change-me-change-me-change-me-change-me"
# Dossier où sont stockées les archives d'agents
STORAGE_DIR="./storage"
# Taille maximale d'une archive, en mégaoctets
MAX_UPLOAD_MB=50
# Production derrière un proxy : domaines autorisés à envoyer les formulaires, séparés par des virgules
# ALLOWED_ORIGINS="agent-market.fr,www.agent-market.fr"
# Adresse publique du site, utilisée dans les liens renvoyés aux orchestrateurs (MCP).
# Facultatif : déduite de la requête (et de l'adresse du codespace) si absente.
# SITE_URL="https://agent-market.fr"
